# ══════════════════════════════════════════════════════════════════════════════
# Personal AI Chief of Staff — Environment Configuration
# Copy this file to .env and fill in all required values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="AI Chief of Staff"
DEBUG=false
# Generate with: openssl rand -hex 32
SECRET_KEY=your_256_bit_hex_secret_key_here_change_this
ENVIRONMENT=production

# ─── Admin ────────────────────────────────────────────────────────────────────
# Your WhatsApp phone number with country code (no + prefix, e.g. 14155551234)
ADMIN_PHONE_NUMBER=14155551234
# Secret for POST /auth/token admin bootstrap. Generate: openssl rand -hex 24
ADMIN_SECRET=your_admin_secret_here_change_this
TIMEZONE=America/New_York

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chiefofstaff
POSTGRES_USER=cosuser
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change_me_strong_password
# Constructed automatically in docker-compose from above values.
# Set this for running backend outside Docker:
DATABASE_URL=postgresql+asyncpg://cosuser:change_me_strong_password@localhost:5432/chiefofstaff

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Generate: openssl rand -hex 24
REDIS_PASSWORD=redispass
REDIS_URL=redis://:redispass@redis:6379/0
# Session context TTL in seconds (default 24h)
REDIS_CONTEXT_TTL=86400
# Max messages in short-term context window
REDIS_CONTEXT_MAX_MESSAGES=20

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
# Optional: set for secured Qdrant instance
QDRANT_API_KEY=
QDRANT_MEMORY_COLLECTION=memories
QDRANT_KNOWLEDGE_COLLECTION=knowledge

# ─── Ollama (Local LLM) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
# Default model for general chat
OLLAMA_DEFAULT_MODEL=qwen3:latest
# Model for fast responses (routing/classification)
OLLAMA_FAST_MODEL=mistral:latest
# Model for deep reasoning (research/analysis)
OLLAMA_REASONING_MODEL=deepseek-r1:latest
# Embedding model (for vector search)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT=120

# ─── WhatsApp Business API ────────────────────────────────────────────────────
# From Meta Developer Console → Your App → WhatsApp → API Setup
WHATSAPP_API_TOKEN=your_whatsapp_access_token_here
# Phone Number ID from Meta Developer Console
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# Custom string used to verify webhook with Meta (any random string)
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
# App Secret from Meta Developer Console (used for HMAC signature verification)
WHATSAPP_APP_SECRET=your_app_secret_here
WHATSAPP_API_VERSION=v18.0

# ─── Whisper (Speech-to-Text) ─────────────────────────────────────────────────
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
# Options: int8, float16, float32
WHISPER_COMPUTE_TYPE=int8

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
# Token expiry in minutes (default: 24 hours)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── n8n ──────────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
# Generate: openssl rand -hex 16
N8N_BASIC_AUTH_PASSWORD=change_me_n8n_password
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ─── Backend URL (used for OAuth redirects in agent messages) ─────────────────
# Set to your public URL when using Cloudflare Tunnel / ngrok
BACKEND_URL=http://localhost:8000

# ─── Email Integration (Phase 2) ─────────────────────────────────────────────
# Gmail — create credentials at console.cloud.google.com
# OAuth redirect URI must be registered in Google Cloud Console
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/email/auth/gmail/callback

# Outlook / Office 365 — register app at portal.azure.com
# OUTLOOK_TENANT_ID: use "common" for personal/work, or your tenant GUID
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8000/api/v1/email/auth/outlook/callback
OUTLOOK_TENANT_ID=common

# ─── Calendar Integration (Phase 4) ──────────────────────────────────────────
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# ─── Research Agent (Phase 5) ─────────────────────────────────────────────────
# Option A: Brave Search API (free tier at brave.com/search/api)
BRAVE_SEARCH_API_KEY=
# Option B: self-hosted SearXNG instance (either one enables research)
SEARXNG_URL=
